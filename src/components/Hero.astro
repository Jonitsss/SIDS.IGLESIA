      </div>
    </div>
    <div class="hero-line">
      <span class="hero-text">DEL</span>
      <div class="hero-imgs">
        <div class="hero-img"><img src="/assets/img/hero-05.jpg" alt="" loading="lazy" /></div>
        <div class="hero-img"><img src="/assets/img/hero-06.jpg" alt="" loading="lazy" /></div>
      </div>
    </div>
    <div class="hero-line">
