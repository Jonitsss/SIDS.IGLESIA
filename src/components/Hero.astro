---
// Hero: título tipográfico a 4 líneas + grid de imágenes.
---

<section class="hero">
  <div class="hero-content">
    <div class="hero-line">
      <span class="hero-text">SANTA</span>
      <div class="hero-imgs">
        <div class="hero-img"><img src="/assets/img/feature-church.png" alt="" loading="lazy" /></div>
        <div class="hero-img"><img src="/assets/img/hero-02.jpg" alt="" loading="lazy" /></div>
      </div>
    </div>
    <div class="hero-line">
      <span class="hero-text">IGLESIA</span>
      <div class="hero-imgs">
        <div class="hero-img"><img src="/assets/img/Musicosection.jpg" alt="" loading="lazy" /></div>
        <div class="hero-img hero-img-bottom"><img src="/assets/img/foto1.jpg" alt="" loading="lazy" /></div>
      </div>
    </div>
    <div class="hero-line">
      <span class="hero-text">DEL</span>
      <div class="hero-imgs">
        <div class="hero-img hero-img-top-9"><img src="/assets/img/hero-05.jpg" alt="" loading="lazy" /></div>
        <div class="hero-img hero-img-top-soft"><img src="/assets/img/hero-06.jpg" alt="" loading="lazy" /></div>
      </div>
    </div>
    <div class="hero-line">
      <span class="hero-text">SEÑOR</span>
      <div class="hero-imgs">
        <div class="hero-img hero-img-top"><img src="/assets/img/feature-domingo.png" alt="" loading="lazy" /></div>
        <div class="hero-img hero-img-bottom"><img src="/assets/img/feature-domingo.png" alt="" loading="lazy" /></div>
      </div>
    </div>
  </div>
  <div class="hero-foot">
    <span>Jueves 20:00 hs · Sábado 18:00 hs · Domingo 18:00 hs</span>
    <span class="hero-scroll">↓ Scroll</span>
  </div>
</section>
